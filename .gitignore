# ─────────────────────────────────────────────
#  SMARTPARKING — Root .gitignore
# ─────────────────────────────────────────────

# ── Dependencies (KABHI UPLOAD MAT KARO) ──
node_modules/
**/node_modules/

# ── Environment / Secrets (KABHI UPLOAD MAT KARO) ──
.env
.env.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.production

# ── Build Output (generated files, zaroorat nahi) ──
dist/
**/dist/
build/
**/build/

# ── Vite cache / temp files ──
.vite/
**/.vite/
vite.config.js.timestamp-*

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Package lock (optional — rakhna better hai) ──
# package-lock.json

# ── Kilo editor (internal tool) ──
.kilo/
